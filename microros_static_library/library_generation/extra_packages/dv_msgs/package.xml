<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dv_msgs</name>
  <version>0.1.0</version>
  <description>
    ROS 2 interface package for the IFS08 uDV node.
    Defines the SetMission and RuntimeControl actions used between the
    autonomy stack and the STM32 driverless controller.
  </description>
  <maintainer email="dv@isc-fs.org">ISC-FS DV</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <build_depend>action_msgs</build_depend>
  <build_export_depend>action_msgs</build_export_depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
